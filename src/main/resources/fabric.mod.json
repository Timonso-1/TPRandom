{
  "schemaVersion": 1,
  "id": "tprandom",
  "version": "${version}",
  "name": "TPRandom",
  "description": "Randomly teleport around the world. Source & issues: https://github.com/Timonso-1/TPRandom",
  "authors": [],
  "contact": {
    "homepage": "https://github.com/Timonso-1/TPRandom",
    "sources": "https://github.com/Timonso-1/TPRandom",
    "issues": "https://github.com/Timonso-1/TPRandom/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/tprandom/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "de.timonso.tprandom.client.TprandomDataGenerator"
    ],
    "client": [
      "de.timonso.tprandom.client.TprandomClient"
    ],
    "main": [
      "de.timonso.tprandom.Tprandom"
    ]
  },
  "mixins": [
    "tprandom.mixins.json",
    {
      "config": "tprandom.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
